+            ae_np_lan_prune_discovered();
+            if (g_lnch_lan_discovered_n > 0)
+                return ae_np_lan_fill_lobby_from_discovered(lan_i, out);
+            return (lan_i == 0 && ae_np_lan_list_visible())
+                ? ae_np_read_lan_lobby(out) : 0;
