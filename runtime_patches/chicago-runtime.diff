-static int aspect_gcd(int a, int b) {
-    while (b) { int t = a % b; a = b; b = t; }
-    return a > 0 ? a : 1;
-}
-
-static int64_t aspect_gcd64(int64_t a, int64_t b) {
-    if (a < 0) a = -a;
-    if (b < 0) b = -b;
-    while (b) { int64_t t = a % b; a = b; b = t; }
-    return a > 0 ? a : 1;
-}
