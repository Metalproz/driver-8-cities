-    if (!json_get_str(json, "hi", hi_str, sizeof(hi_str))) { send_err(id, "missing hi"); return; }
-    uint32_t lo = hex_to_u32(lo_str) & 0x1FFFFFFFu;
-    uint32_t hi = hex_to_u32(hi_str) & 0x1FFFFFFFu;
