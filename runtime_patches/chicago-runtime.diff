+/* cyc_watch_clear — disarm and zero the ring. */
+static void handle_cyc_watch_clear(int id, const char *json)
+{
+    (void)json;
+    s_cyc_watch_armed = 0;
+    s_cyc_watch_hits  = 0;
+    s_cyc_watch_anchor_phys = 0;
+    s_cyc_watch_anchor_raw  = 0;
+    s_cyc_watch_end_phys = 0;
+    s_cyc_watch_end_raw  = 0;
