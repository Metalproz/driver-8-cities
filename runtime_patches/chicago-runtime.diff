+        std::snprintf(out->game_version, sizeof(out->game_version), "%s", row.game_version);
+        out->player_count = row.player_count;
+        out->max_slots = row.max_slots;
+        out->has_password = row.has_password;
+        out->latency_ms = row.latency_ms;
+        return 1;
