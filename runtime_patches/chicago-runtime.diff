-/* driver_personal (Option A r3, 16.10.): game.toml [game] prelaunch = "<command>" (run in the project
- * root) prepares mod content from the registered input discs before the mods load: "<command>
- * --build-dir <exe dir> --check" runs hidden (exit 0 = current -> boot at once, 10 = build due); a
- * due build runs "<command> --build-dir <exe dir>" in its own console window titled "Building
- * Chicago from your Driver 2 discs" and the boot waits for it. Never in headless runs (tests) or
- * with PSX_NO_PRELAUNCH=1. Host-only (Python on the player's PC; the tool form is still open). */
-static std::string g_prelaunch_cmd;
-static std::filesystem::path g_prelaunch_root;
-
-static void run_prelaunch(const std::filesystem::path& exe_dir) {
-    if (g_prelaunch_cmd.empty() || g_headless) return;
-    const char* off = std::getenv("PSX_NO_PRELAUNCH");
-    if (off && off[0] == '1') return;
-#ifdef _WIN32
-    const std::string base = g_prelaunch_cmd + " --build-dir \"" + exe_dir.string() + "\"";
-    const std::string root = g_prelaunch_root.string();
-    auto run = [&](const std::string& cmd, DWORD flags, const char* title) -> long {
-        STARTUPINFOA si{};
-        si.cb = sizeof(si);
-        si.lpTitle = const_cast<char*>(title);
-        PROCESS_INFORMATION pi{};
-        std::vector<char> buf(cmd.begin(), cmd.end());
-        buf.push_back('\0');
-        if (!CreateProcessA(nullptr, buf.data(), nullptr, nullptr, FALSE, flags, nullptr,
-                            root.empty() ? nullptr : root.c_str(), &si, &pi))
-            return -1;
-        WaitForSingleObject(pi.hProcess, INFINITE);
-        DWORD code = 1;
-        GetExitCodeProcess(pi.hProcess, &code);
-        CloseHandle(pi.hThread);
-        CloseHandle(pi.hProcess);
-        return (long)code;
-    };
-    long rc = run(base + " --check", CREATE_NO_WINDOW, nullptr);
-    std::fprintf(stderr, "psxrecomp: prelaunch check (%s): %ld (%s)\n", g_prelaunch_cmd.c_str(), rc,
-                 rc == 0 ? "content current" : rc == 10 ? "build due" : "error");
-    if (rc == 10) {
-        rc = run(base, CREATE_NEW_CONSOLE, "Building Chicago from your Driver 2 discs");
-        std::fprintf(stderr, "psxrecomp: prelaunch build: exit %ld\n", rc);
-    }
-    if (rc != 0)
-        launcher_warning("Chicago",
-            "Chicago could not be prepared from the Driver 2 discs (prelaunch exit " + std::to_string(rc) +
-            "; details in setup_cache/logs/auto.log). Driver 1's cities still work.");
-#else
-    (void)exe_dir;
-#endif
-}
