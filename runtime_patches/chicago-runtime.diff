-static void close_player(PlayerInput& p) {
-    if (p.handle) {
-        if (p.rumble_small || p.rumble_large)
-            (void)SDL_GameControllerRumble(p.handle, 0, 0, 0);
-        SDL_GameControllerClose(p.handle);
-        p.handle = nullptr;
-        p.instance = -1;
-    }
-    p.rumble_small = 0;
-    p.rumble_large = 0;
-    p.rumble_known = false;
-    p.rumble_warned = false;
-}
