-static int present_effective_swap_interval(void) {
-    if (g_netplay_vsync_forced_off || psx_netplay_active())
-        return 0;
-    if (g_frame_interpolation)
-        return 0;
-    if (g_frame_period_ms <= 0.0)
-        return 0;
-    if (present_vsync_owns_cadence())
-        return g_video_vsync;
-    return 0;
-}
