+            } else {
+                vk_renderer_present_vram((int)di.display_x, (int)di.display_y,
+                                         (int)present_w, (int)h, g_video_aa ? 1 : 0,
+                                         (fmv_frame || nw_pin) ? 1 : 0);
+            }
