-            "\"s7508\":\"0x%08X\",\"s750c\":\"0x%08X\",\"s7510\":\"0x%08X\","
-            "\"s7514\":\"0x%08X\",\"s7518\":\"0x%08X\",\"s751c\":\"0x%08X\","
-            "\"s7520\":\"0x%08X\","
-            "\"s7528\":\"0x%08X\",\"s752c\":\"0x%08X\",\"s7558\":\"0x%08X\","
-            "\"s7568\":\"0x%08X\",\"s756c\":\"0x%08X\"}",
-            first ? "" : ",",
