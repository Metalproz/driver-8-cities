-    if (window < 1) window = 1;
-    if (window > 65536) window = 65536;
-
-    extern int sio_get_mc_max_state(void);
-    extern int sio_get_mc_abort_count(void);
-    extern int sio_get_mc_read_done(void);
-    extern int sio_get_tx_writes(void);
