-static std::string trim_copy(const std::string& s) {
-    size_t first = 0;
-    while (first < s.size() && std::isspace((unsigned char)s[first])) first++;
-    size_t last = s.size();
-    while (last > first && std::isspace((unsigned char)s[last - 1])) last--;
-    return s.substr(first, last - first);
-}
