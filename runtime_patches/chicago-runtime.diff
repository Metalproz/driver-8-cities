-/* driver_personal (Option A, R25, 16.10.): SETUP-INPUT discs in the roster.
- * game.toml [game] boot_discs = N: only the first N entries of [game] discs
- * boot; the rest are input discs (Driver 2 disc 1 + 2: their city data is
- * converted into the Chicago package at setup, chicago/setup_chicago.py).
- * The launcher lists them (label says what they are and whether the image
- * is there and is the right disc), but they are never mounted: a launch with
- * one selected boots disc 1. 0 / absent = upstream behaviour (every disc
- * boots). Read straight from game.toml so config_loader stays upstream. */
-static int g_boot_discs = 0;
-
-/* Raw value of a top-level key in game.toml's [game] table ("" if absent); one surrounding pair of
- * quotes is removed. Enough for the two driver_personal keys (boot_discs, prelaunch). */
-static std::string read_game_key(const std::filesystem::path& cfg, const std::string& key) {
-    std::ifstream f(cfg);
-    std::string line;
-    bool in_game = false;
-    while (std::getline(f, line)) {
-        size_t a = line.find_first_not_of(" \t\r");
-        if (a == std::string::npos || line[a] == '#') continue;
-        if (line[a] == '[') { in_game = line.compare(a, 6, "[game]") == 0; continue; }
-        if (!in_game || line.compare(a, key.size(), key) != 0) continue;
-        size_t eq = line.find('=', a + key.size());
-        if (eq == std::string::npos || line.find_first_not_of(" \t", a + key.size()) != eq) continue;
-        std::string v = line.substr(eq + 1);
-        size_t b = v.find_first_not_of(" \t"), e = v.find_last_not_of(" \t\r");
-        if (b == std::string::npos) return std::string();
-        v = v.substr(b, e - b + 1);
-        if (!v.empty() && v.front() == '"') {                 /* "string" [# comment] */
-            size_t q = v.find('"', 1);
-            return q == std::string::npos ? v.substr(1) : v.substr(1, q - 1);
-        }
-        size_t hash = v.find('#');                             /* bare value [# comment] */
-        if (hash != std::string::npos) v = v.substr(0, hash);
-        e = v.find_last_not_of(" \t");
-        return e == std::string::npos ? std::string() : v.substr(0, e + 1);
-    }
-    return std::string();
-}
-
-static int read_boot_discs(const std::filesystem::path& cfg) {
-    return std::max(0, std::atoi(read_game_key(cfg, "boot_discs").c_str()));
-}
