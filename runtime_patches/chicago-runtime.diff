-static void handle_vram_peek(int id, const char *json)
-{
-    int x = json_get_int(json, "x", 0);
-    int y = json_get_int(json, "y", 0);
-    int w = json_get_int(json, "w", 8);
-    int h = json_get_int(json, "h", 1);
-    if (w < 1) w = 1;
-    if (h < 1) h = 1;
-    if (w > 128) w = 128;
-    if (h > 128) h = 128;
