+    static int ae_np_lan_find_free_slot(const AeLanLobbyState& state) {
+        for (int i = 0; i < state.max_slots && i < kAeLanMaxSlots; ++i) {
+            if (i == state.host_slot) continue;
+            if (state.slot_name[i].empty()) return i;
+        }
+        return -1;
+    }
