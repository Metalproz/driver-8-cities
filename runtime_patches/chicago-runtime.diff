-static int device_claimed_by_other(int self_slot, SDL_JoystickID inst) {
-    for (int o = 0; o < PSX_MAX_PLAYERS; o++) {
-        if (o == self_slot) continue;
-        if (g_players[o].handle && g_players[o].instance == inst) return 1;
-    }
-    return 0;
