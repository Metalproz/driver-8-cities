+    e->v0           = cpu->gpr[2];
+    e->v1           = cpu->gpr[3];
+    e->a0           = cpu->gpr[4];
+    e->a1           = cpu->gpr[5];
+    e->a2           = cpu->gpr[6];
+    e->a3           = cpu->gpr[7];
+    e->sr           = cpu->cop0[12];
+    e->epc          = cpu->cop0[14];
