-            char stall[64];
-            uint32_t sim = 0;
-            int lead = 0;
-            psx_netplay_admit_wait_info(stall, sizeof(stall), &sim, &lead);
-            std::fprintf(stderr,
-                         "psxrecomp: netplay admit stall timeout sim=%u "
