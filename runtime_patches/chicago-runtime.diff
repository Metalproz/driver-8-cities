+    static int ae_np_lan_discovered_find(const char* endpoint) {
+        if (!endpoint || !endpoint[0]) return -1;
+        for (int i = 0; i < g_lnch_lan_discovered_n; ++i) {
+            if (std::strcmp(g_lnch_lan_discovered[i].endpoint, endpoint) == 0)
+                return i;
+        }
+        return -1;
+    }
