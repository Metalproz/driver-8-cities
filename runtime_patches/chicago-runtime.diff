+    switch (func) {
+        case 0x80068AA8u:
+        case 0x80068DDCu:
+        case 0x80068E5Cu:
+            return 0x8009B3A0u + ((cpu->gpr[4] & 0x00F0u) ? 0xF0u : 0u);
+        case 0x8006A0C0u:
+        case 0x8006A128u:
+        case 0x8006A144u:
+        case 0x8006A378u:
