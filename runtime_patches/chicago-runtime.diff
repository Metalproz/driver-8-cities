+    if (fmv_skip_active) {
+        const int FMV_PRESENT_EVERY = 30;
+        s_fmv_skip_present_skip = (s_fmv_skip_present_skip + 1) % FMV_PRESENT_EVERY;
+        if (s_fmv_skip_present_skip != 0) {
+            ep.skip_pace = 1;
+            return ep;
+        }
+    }
+
+    /* Netplay FMV: present 1 of every N depth24 vblanks while MDEC is hot.
