-            }
-
-            if (std::strncmp(buf, "MOTK1 JOIN\n", 11) == 0 && g_lnch_hosting_lan) {
-                char* p = buf + 11;
-                char* nl = std::strchr(p, '\n');
-                if (!nl) continue;
-                *nl = '\0';
-                const char* name = p;
-                p = nl + 1;
-                nl = std::strchr(p, '\n');
