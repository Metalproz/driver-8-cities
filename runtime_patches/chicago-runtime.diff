-                        "\"a0\":\"0x%08X\",\"a1\":\"0x%08X\","
-                        "\"a2\":\"0x%08X\",\"a3\":\"0x%08X\","
-                        "\"t0\":\"0x%08X\",\"t1\":\"0x%08X\","
-                        "\"s0\":\"0x%08X\",\"s1\":\"0x%08X\","
-                        "\"s2\":\"0x%08X\",\"s3\":\"0x%08X\","
-                        "\"s4\":\"0x%08X\",\"s5\":\"0x%08X\","
