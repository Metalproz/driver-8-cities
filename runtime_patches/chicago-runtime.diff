-        int slot = -1;
-        if (g_lnch_hosting_lan) {
-            AeLanLobbyState st;
-            if (ae_np_read_lan_state(&st)) slot = st.host_slot;
-        } else {
-            slot = g_lnch_lan_my_slot;
-        }
-        if (slot < 0 || !offer || !offer->valid) return;
