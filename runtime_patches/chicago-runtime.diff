-        char host[64];
-        if (!ae_np_lan_endpoint_host(endpoint, host, sizeof(host))) {
-            if (endpoint[0] == ':' || !endpoint[0])
-                std::snprintf(host, sizeof(host), "0.0.0.0");
-            else
-                return false;
-        }
-        const int n = std::snprintf(endpoint, cap, "%s:%d", host, port);
