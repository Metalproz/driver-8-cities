-                AeLanLobbyState st;
-                if (!ae_np_read_lan_state(&st)) continue;
-                if (st.password != pass) {
-                    ae_np_lan_udp_sendto(from, "MOTK1 ERR\nbad_password\n");
-                    continue;
-                }
-                /* Legacy JOIN: synthesize an id from peer addr so same-name
