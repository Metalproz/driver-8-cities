+    static void ae_np_lan_udp_close(void) {
+        ae_np_lan_sock_close(&g_lnch_lan_udp);
+        for (int i = 0; i < kAeLanMaxSlots; ++i)
+            g_lnch_lan_peer_ok[i] = false;
