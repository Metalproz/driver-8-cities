+    static void ae_np_lan_sock_close(AeLanSock* s) {
+        if (!s || *s == kAeLanSockInvalid) return;
+#ifdef _WIN32
+        closesocket(*s);
+#else
+        close(*s);
+#endif
+        *s = kAeLanSockInvalid;
+    }
