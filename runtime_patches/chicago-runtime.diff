-            e->s0, e->s1, e->s2, e->s3, e->depth, e->frame,
-            (unsigned long long)e->paired_exit_seq);
-        first = 0;
-        emitted++;
-    }
-    pos += snprintf(buf + pos, BUF_SZ - pos, "],\"emitted\":%d}", emitted);
-    debug_server_send_line(buf);
-    free(buf);
-}
