+/* Local (driver.personal): multi-line dev panel, drawn top-right at half the
+ * toast size. Set from the emulation thread, rasterized on present; a torn
+ * read only garbles one frame of text. */
+#define PANEL_COLS   40
+#define PANEL_ROWS   8
+#define PANEL_LINE_H (OSD_GLYPH_H + 2)
+#define PANEL_IMG_W  (OSD_PAD_X * 2 + PANEL_COLS * OSD_GLYPH_W)
+#define PANEL_IMG_H  (OSD_PAD_Y * 2 + PANEL_ROWS * PANEL_LINE_H)
+static char     s_panel_msg[PANEL_ROWS * (PANEL_COLS + 1) + 1];
+static int      s_panel_active;
+static int      s_panel_dirty;
+static uint32_t s_panel_img[PANEL_IMG_W * PANEL_IMG_H];
+static int      s_panel_w;
+static int      s_panel_h;
+
+void host_osd_set_panel(const char *text) {
+#if !HOST_OSD_VISUAL
+    (void)text;
+#else
+    if (!text || !text[0]) {
+        if (s_panel_active) s_needs_clear = 1;
+        s_panel_active = 0;
+        s_panel_msg[0] = '\0';
+        return;
+    }
+    if (s_panel_active && strcmp(s_panel_msg, text) == 0)
+        return;
+    snprintf(s_panel_msg, sizeof(s_panel_msg), "%s", text);
+    s_panel_active = 1;
+    s_panel_dirty = 1;
+#endif
+}
+
+#if HOST_OSD_VISUAL
+static void rasterize_panel(void) {
+    char msg[sizeof(s_panel_msg)];
+    int rows = 0, cols = 0, c = 0;
+    snprintf(msg, sizeof(msg), "%s", s_panel_msg);
+    for (const char *p = msg; ; p++) {
+        if (*p == '\n' || !*p) {
+            if (c > cols) cols = c;
+            rows++;
+            c = 0;
+            if (!*p || rows == PANEL_ROWS) break;
+        } else {
+            c++;
+        }
+    }
+    if (cols > PANEL_COLS) cols = PANEL_COLS;
+    if (cols < 1) cols = 1;
+    s_panel_w = OSD_PAD_X * 2 + cols * OSD_GLYPH_W;
+    s_panel_h = OSD_PAD_Y * 2 + rows * PANEL_LINE_H;
+    for (int i = 0; i < s_panel_w * s_panel_h; i++)
+        s_panel_img[i] = 0xFF202020u;
+    int row = 0, col = 0;
+    for (const char *p = msg; *p && row < PANEL_ROWS; p++) {
+        if (*p == '\n') { row++; col = 0; continue; }
+        if (col >= PANEL_COLS) continue;
+        unsigned char ch = (unsigned char)*p;
+        if (ch < 32 || ch > 126) ch = '?';
+        const uint8_t *g = FONT8X8[ch - 32];
+        for (int gy = 0; gy < OSD_GLYPH_H; gy++)
+            for (int gx = 0; gx < OSD_GLYPH_W; gx++)
+                if (g[gy] & (1u << gx)) {
+                    int x = OSD_PAD_X + col * OSD_GLYPH_W + gx;
+                    int y = OSD_PAD_Y + row * PANEL_LINE_H + gy;
+                    s_panel_img[y * s_panel_w + x] = 0xFFFFFFFFu;
+                }
+        col++;
+    }
+}
+#endif
+
+int host_osd_panel_image(const uint32_t **pixels, int *w, int *h) {
+#if HOST_OSD_VISUAL
+    if (s_panel_active) {
+        if (s_panel_dirty || !s_panel_w) {
+            s_panel_dirty = 0;
+            rasterize_panel();
+        }
+        if (pixels) *pixels = s_panel_img;
+        if (w) *w = s_panel_w;
+        if (h) *h = s_panel_h;
+        return 1;
+    }
+#endif
+    if (pixels) *pixels = NULL;
+    if (w) *w = 0;
+    if (h) *h = 0;
+    return 0;
+}
