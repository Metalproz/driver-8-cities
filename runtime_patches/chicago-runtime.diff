+static void synthesize_raw_sector(uint32_t lba, uint8_t* raw) {
+    std::memset(raw, 0, 2352);
+    std::memset(raw + 1, 0xFF, 10);          /* sync: 00 FF*10 00 */
+    const uint32_t abs = lba + 150;
+    raw[12] = to_bcd(abs / 4500);
+    raw[13] = to_bcd((abs / 75) % 60);
+    raw[14] = to_bcd(abs % 75);
+    raw[15] = 2;                              /* mode 2 */
+    raw[18] = raw[22] = 0x08;                 /* subheader: data, form 1 */
+}
