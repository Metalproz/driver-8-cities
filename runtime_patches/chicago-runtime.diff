-static int netplay_local_viewport_slot(void) {
-    if (g_netplay_local_viewport != 1 || !psx_netplay_active())
-        return -1;
-    if (!gpu_last_frame_vertical_split_screen())
-        return -1;
-    int slot = psx_netplay_local_slot();
