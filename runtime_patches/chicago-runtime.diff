-                    to.sin_family = AF_INET;
-                    to.sin_port =
-                        htons((uint16_t)ae_np_lan_endpoint_port(g_lnch_lan_endpoint));
-                    if (inet_pton(AF_INET, host, &to.sin_addr) == 1) {
-                        char leave_msg[160];
-                        std::snprintf(leave_msg, sizeof(leave_msg),
-                                      "MOTK3 LEAVE\n%s\n",
-                                      ae_np_lan_local_player_id());
