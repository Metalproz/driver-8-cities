+     * still run every tick. During MDEC-idle cutover present every frame.
+     * Override: PSX_NET_FMV_PRESENT_DIV (1=every frame, 2=default, 4=legacy). */
+    if (psx_netplay_active() && gpu_display_is_depth24() &&
