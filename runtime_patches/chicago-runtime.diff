-                            "(%.4f ms/frame); driver vsync off on %.0f Hz panel\n",
-                            g_frame_period_ms, g_host_refresh_hz);
-            } else {
-                std::printf("psxrecomp: present cadence: wall-clock pacer "
-                            "(%.4f ms/frame); driver vsync off "
-                            "(host refresh unknown)\n",
-                            g_frame_period_ms);
-            }
-        } else {
