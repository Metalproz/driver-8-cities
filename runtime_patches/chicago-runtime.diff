+static void rewind_poll_toggle_buttons(void) {
+    static int was_down;
+    int down = rewind_toggle_buttons_down();
+    if (down && !was_down && !psx_rewind_is_open())
+        psx_rewind_toggle();
+    was_down = down;
+}
