+static void append_word_array(char *buf, size_t bufsz, size_t *pos,
+                              const uint32_t *words, int count)
+{
+    *pos += snprintf(buf + *pos, bufsz - *pos, "[");
+    for (int i = 0; i < count && *pos < bufsz - 16; i++) {
+        *pos += snprintf(buf + *pos, bufsz - *pos,
+                         "%s\"0x%08X\"", i ? "," : "", words[i]);
+    }
+    *pos += snprintf(buf + *pos, bufsz - *pos, "]");
+}
