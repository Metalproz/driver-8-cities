+    static int ae_np_lan_occupied(const AeLanLobbyState& state) {
+        int n = 0;
+        for (int i = 0; i < state.max_slots && i < kAeLanMaxSlots; ++i)
+            if (!state.slot_name[i].empty()) ++n;
+        return n;
+    }
